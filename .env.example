# SENA keyless wallet. Copy to .env and fill in.

# Google OAuth 2.0 client (Google Cloud Console -> APIs & Services -> Credentials
# -> Create credentials -> OAuth client ID -> Web application). Add the wallet's
# address, e.g. http://localhost:5173, under BOTH "Authorised JavaScript origins"
# and "Authorised redirect URIs". No client secret is needed or used.
VITE_GOOGLE_CLIENT_ID=

# The SENA node; bun run devnet starts one here.
VITE_SENA_RPC_URL=http://127.0.0.1:8545

# Aptos's keyless pepper and proving services. Testnet's prove for the same
# parameters SENA verifies against. An Aptos Build API key raises rate limits.
VITE_APTOS_KEYLESS_URL=https://api.testnet.aptoslabs.com/keyless
VITE_APTOS_API_KEY=

# The faucet; bun run devnet starts one here. FAUCET_KEY_FILE is only needed
# to run the faucet on its own (bun run faucet) against another devnet.
VITE_FAUCET_URL=http://127.0.0.1:3001
FAUCET_KEY_FILE=
