# ==============================================================================
# SENA Keyless Wallet - Environment Variables Template
# Copy this file to .env and insert your Google Cloud Console OAuth credentials.
# ==============================================================================

# 1. Google OAuth 2.0 Web Client ID
# Format: 1234567890-abcdefghijklmnopqrstuvwxyz.apps.googleusercontent.com
# From: https://console.cloud.google.com/apis/credentials -> Create Credentials -> OAuth Client ID -> Web application
# Authorized JavaScript origins: http://localhost:5173, http://127.0.0.1:5173
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# 2. Google OAuth 2.0 Client Secret (Optional for client-only flow, used if exchanging code)
VITE_GOOGLE_CLIENT_SECRET=your-google-client-secret

# 3. SENA L2 Node RPC URL
# Defaults to local devnet node or automatic simulation engine
VITE_SENA_RPC_URL=http://127.0.0.1:8080
